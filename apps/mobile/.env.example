# Expo reads .env from the app directory (apps), NOT the repo root.
# Copy this file to apps/.env and fill in the values, then restart the
# dev server with a cleared cache: npx expo start -c
#
# Only EXPO_PUBLIC_* variables are inlined into the client bundle. A bare
# SUPABASE_URL (as listed in the root .env.example) is a server-side name and is
# NOT visible to the mobile app — auth silently falls back to the local mock if
# these two are missing.
#
# Both values below are safe to ship in a client bundle. Never put
# SUPABASE_SERVICE_ROLE_KEY here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
