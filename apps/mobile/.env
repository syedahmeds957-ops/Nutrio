# Supabase Configuration
# To connect your own live Supabase project, replace the placeholder URL and Anon key below.
# With placeholders, Nutrio automatically runs in offline/local demo mode with instant sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://qcdfluglkwvmjusncaas.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P-oWwPsg_rsZTT-7CjAIJg_oVRjw5Co

# Expo inlines ONLY EXPO_PUBLIC_* into the client bundle; NEXT_PUBLIC_* names
# above are never substituted by Metro, so the app read undefined and silently
# ran in mock mode. These two are what apps/src/supabase/client.ts uses.
EXPO_PUBLIC_SUPABASE_URL=https://qcdfluglkwvmjusncaas.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P-oWwPsg_rsZTT-7CjAIJg_oVRjw5Co
